<%@ Master Language="C#" AutoEventWireup="true" CodeFile="MasterPage.master.cs" Inherits="MasterPage" %>

<!DOCTYPE html>
<html dir="rtl" lang="he">
<head runat="server">
    <title>עולם סדרות הנוער</title>
    <link rel="stylesheet" type="text/css" href="StyleSheet.css" />
    <meta charset="utf-8" />
    <style>
        body {
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #fdfbfb 0%, #ebedee 100%);
            font-family: 'Segoe UI', system-ui, sans-serif;
            color: #444;
            min-height: 100vh;
        }

        header {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(12px);
            position: sticky;
            top: 0;
            z-index: 1000;
            padding: 25px 0;
            box-shadow: 0 4px 20px rgba(174, 198, 207, 0.2);
            border-bottom: 1px solid rgba(174, 198, 207, 0.3);
        }

        .header-content {
            max-width: 1200px;
            margin: 0 auto;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .header_top {
            width: 90%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }

        .main-logo {
            width: 220px; /* לוגו גדול ומרשים */
            height: auto;
        }

        .date-box {
            color: #AEC6CF;
            font-weight: 700;
            font-size: 1.1rem;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .main_nav {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            justify-content: center;
        }

        .main_nav a {
            text-decoration: none;
            color: #6a7f8a;
            font-weight: 600;
            padding: 10px 22px;
            border-radius: 50px;
            background: rgba(255, 255, 255, 0.6);
            transition: all 0.3s ease;
            font-size: 1.05rem;
        }

        .main_nav a:hover {
            background: #fff;
            color: #AEC6CF;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(174, 198, 207, 0.3);
        }

        .page-wrapper {
            max-width: 1100px;
            margin: 40px auto;
            padding: 0 20px;
            animation: fadeIn 0.8s ease;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(15px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* שטח ה-Main - מוודא שכל מה שבתוכו יכול להתמרכז */
        main {
            display: flex;
            flex-direction: column;
            align-items: center; /* ממרכז את כל התוכן של ה-Main */
            width: 100%;
        }

        .aside-card {
            background: white;
            padding: 20px 30px;
            border-radius: 20px;
            text-align: center;
            box-shadow: 0 10px 30px rgba(0,0,0,0.03);
            border: 1px solid #f0f0f0;
            margin-bottom: 30px;
            width: 100%; /* שיתפוס את כל הרוחב המוקצה */
            box-sizing: border-box;
        }

        /* תיקון סופי למרכוז התמונה */
        .aside-img, .series-img, main img {
            max-width: 85%;
            max-height: 500px;
            object-fit: contain;
            display: block;
            margin: 25px auto !important; /* ה-important מבטל הגדרות אחרות שדוחפות לצד */
            border-radius: 24px;
            box-shadow: 0 15px 45px rgba(0,0,0,0.1);
            border: 6px solid white;
        }

        footer {
            text-align: center;
            padding: 60px 0;
            color: #b0bec5;
            font-size: 0.95rem;
        }
    </style>
    <asp:ContentPlaceHolder id="head" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
    <header>
        <div class="header-content">
            <div class="header_top">
                <div class="date-box">
                    <asp:Label ID="DateLabel" runat="server"></asp:Label>
                    <asp:Image ID="DayImage" runat="server" width="45" />
                </div>
                
                <img src="images/logo.png" alt="Logo" class="main-logo" />

                <div class="user-box">
                    <a class="login_logout" ID="LoginLogout" runat="server" style="text-decoration:none; color:#AEC6CF; font-weight:bold; font-size: 1.1rem;"></a>
                </div>
            </div>

            <nav class="main_nav"> 
                <a href="Default.aspx">דף בית</a>
                <a href="אליפים.aspx">אליפים</a>
                <a href="האי.aspx">האי</a>
                <a href="החממה.aspx">החממה</a>
                <a href="השמיניה.aspx">השמיניה</a>
                <a href="גאליס.aspx" id="Galis" runat ="server">גאליס</a>
                <a href="חצויה.aspx">חצויה</a>
                <a href="הילדים מגבעת נפוליאון.aspx">הילדים מגבעת נפוליאון</a>
            </nav>
        </div>
    </header>

    <div class="page-wrapper">
        <section class="top-aside">
            <div class="aside-card">
                <asp:ContentPlaceHolder id="ContentPlaceHolderAside" runat="server">
                    <h3 style="color: #AEC6CF; margin: 0; font-size: 1.3rem;">✨ ברוכים הבאים לעולם הנוסטלגיה</h3>
                </asp:ContentPlaceHolder>
            </div>
        </section>

        <main>
            <asp:ContentPlaceHolder id="ContentPlaceHolderMain" runat="server">
            </asp:ContentPlaceHolder>
        </main>
    </div>

    <footer>
        <p>נבנה באהבה עבור חובבי סדרות הנוער | &copy; <%= DateTime.Now.Year %></p>
    </footer>

    <asp:ContentPlaceHolder id="ContentPlaceHolderScript" runat="server"></asp:ContentPlaceHolder>
</body>
</html>