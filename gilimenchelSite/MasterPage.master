<%@ Master Language="C#" AutoEventWireup="true" CodeFile="MasterPage.master.cs" Inherits="MasterPage" %>

<!DOCTYPE html>
<html dir="rtl" lang="he">
<head runat="server">
    <title>עולם סדרות הנוער</title>
    <link rel="stylesheet" type="text/css" href="StyleSheet.css" />
    <meta charset="utf-8" />
    <style>
        body {
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #fdfbfb 0%, #ebedee 100%);
            font-family: 'Segoe UI', system-ui, sans-serif;
            color: #444;
            min-height: 100vh;
        }

        header {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(12px);
            position: sticky;
            top: 0;
            z-index: 1000;
            padding: 10px 0; /* הקטנתי את הגובה של הכל */
            box-shadow: 0 4px 20px rgba(174, 198, 207, 0.2);
            border-bottom: 1px solid rgba(174, 198, 207, 0.3);
        }

        .header-container {
            max-width: 1300px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 30px;
        }

        /* לוגו בגודל אסתטי */
        .main-logo {
            width: 120px;
            height: auto;
            flex-shrink: 0;
        }

        /* תפריט ניווט - קומפקטי ועדין */
        .main_nav {
            display: flex;
            gap: 5px; /* רווח קטן בין הכפתורים */
            justify-content: center;
            flex: 2; /* נותן לו שטח מרכזי אבל לא נמתח מדי */
        }

        .main_nav a {
            text-decoration: none;
            color: #6a7f8a;
            font-weight: 600;
            padding: 6px 14px; /* הקטנתי את הריווח הפנימי */
            border-radius: 50px;
            background: rgba(255, 255, 255, 0.5);
            font-size: 0.85rem; /* גופן קטן ואסתטי יותר */
            transition: all 0.3s ease;
            white-space: nowrap;
        }

        .main_nav a:hover {
            background: #fff;
            color: #AEC6CF;
            transform: translateY(-1px);
            box-shadow: 0 2px 8px rgba(174, 198, 207, 0.2);
        }

        /* כפתור Login/Logout עדין */
        .login_logout {
            text-decoration: none;
            color: #AEC6CF !important;
            font-weight: 700;
            padding: 6px 16px;
            border: 2px solid #AEC6CF;
            border-radius: 50px;
            transition: all 0.3s ease;
            font-size: 0.8rem;
            white-space: nowrap;
        }

        .login_logout:hover {
            background: #AEC6CF;
            color: white !important;
        }

        .info-section {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 4px;
            flex-shrink: 0;
        }

        .date-box {
            color: #AEC6CF;
            font-weight: 700;
            font-size: 0.8rem;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        /* פריסה כללית */
        .page-wrapper {
            max-width: 1000px;
            margin: 30px auto;
            padding: 0 20px;
        }

        main {
            display: flex;
            flex-direction: column;
            align-items: center;
            width: 100%;
        }

        .aside-card {
            background: white;
            padding: 15px 25px;
            border-radius: 15px;
            text-align: center;
            box-shadow: 0 8px 25px rgba(0,0,0,0.03);
            border: 1px solid #f0f0f0;
            margin-bottom: 20px;
            width: 100%;
        }

        /* מרכוז תמונות */
        .aside-img, .series-img, main img {
            max-width: 80%;
            max-height: 450px;
            display: block;
            margin: 20px auto !important;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            border: 5px solid white;
        }

        footer {
            text-align: center;
            padding: 40px 0;
            color: #b0bec5;
            font-size: 0.85rem;
        }
    </style>
    <asp:ContentPlaceHolder id="head" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
    <header>
        <div class="header-container">
            <img src="images/logo.png" alt="Logo" class="main-logo" />

            <nav class="main_nav"> 
                <a href="Default.aspx">דף בית</a>
                <a href="אליפים.aspx">אליפים</a>
                <a href="האי.aspx">האי</a>
                <a href="החממה.aspx">החממה</a>
                <a href="השמיניה.aspx">השמיניה</a>
                <a href="גאליס.aspx" id="Galis" runat ="server">גאליס</a>
                <a href="חצויה.aspx">חצויה</a>
                <a href="הילדים מגבעת נפוליאון.aspx">הילדים מגבעת</a>
            </nav>

            <div class="info-section">
                <div class="date-box">
                    <asp:Label ID="DateLabel" runat="server"></asp:Label>
                    <asp:Image ID="DayImage" runat="server" width="25" />
                </div>
                <a class="login_logout" ID="LoginLogout" runat="server"></a>
            </div>
        </div>
    </header>

    <div class="page-wrapper">
        <section class="top-aside">
            <div class="aside-card">
                <asp:ContentPlaceHolder id="ContentPlaceHolderAside" runat="server">
                    <h3 style="color: #AEC6CF; margin: 0; font-size: 1rem;">✨ עולם הנוסטלגיה</h3>
                </asp:ContentPlaceHolder>
            </div>
        </section>

        <main>
            <asp:ContentPlaceHolder id="ContentPlaceHolderMain" runat="server">
            </asp:ContentPlaceHolder>
        </main>
    </div>

    <footer>
        <p>&copy; <%= DateTime.Now.Year %> אתר סדרות הנוער</p>
    </footer>

    <asp:ContentPlaceHolder id="ContentPlaceHolderScript" runat="server"></asp:ContentPlaceHolder>
</body>
</html>